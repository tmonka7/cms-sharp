<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net47</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CMS.KeyGen</RootNamespace>
    <AssemblyName>CMS.KeyGen</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CMS.Licensing\CMS.Licensing.csproj" />
  </ItemGroup>

  <!--
    The generator carries its own copy of the palette rather than linking the
    application's Theme.cs, because that file also colours camera status and
    event severity and so depends on CMS.Core. Referencing it here would pull
    OpenCV, ONNX Runtime, SQLite and MongoDB into a tool that signs text files.
  -->
  <ItemGroup>
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
